# ============================================================
# ChayaOne Owner Dashboard — Environment Variables
# Copy this file to .env.local for local development
# ============================================================

# --- Cloud PostgreSQL (Required) -----------------------------------
# Supabase, Neon, Railway, or any cloud Postgres
# Must be the SAME database as the Shop OS (or a cloud replica of it)
DATABASE_URL="postgresql://user:password@host:5432/cafeos?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/cafeos?sslmode=require"

# --- Authentication -----------------------------------------------
# Generate: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
OWNER_JWT_SECRET="change-me-to-another-long-random-string"

# --- App URL (for Vercel, set to your deployment URL) -------------
NEXT_PUBLIC_APP_URL="https://owner.chayaone.com"

# --- Optional: Supabase (if using Supabase for cloud DB) ----------
# SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# SUPABASE_ANON_KEY="anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY="service_role-key"

# --- Development Only (remove in production) ----------------------
# NODE_ENV=development

# ============================================================
# IMPORTANT SECURITY NOTES:
# - Never commit real secrets to version control
# - DATABASE_URL must point to a CLOUD database, NOT localhost
# - JWT_SECRET must be at least 32 characters and random
# - NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here
# ============================================================
