{
  "name": "@cafeos/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "tsc && electron-builder --config electron-builder.yml",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.yml --dir",
    "make": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "express": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.3.0",
    "@electron-forge/maker-squirrel": "^7.3.0",
    "@electron-forge/maker-zip": "^7.3.0",
    "@types/express": "^5.0.6",
    "electron": "29.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0"
  }
}
