# ============================================================
# ChayaOne OS — Environment Configuration Example (.env.example)
# ============================================================

# --- Local PostgreSQL (Main Cafe PC) -------------------------
DATABASE_URL="postgresql://cafeos:cafeos@localhost:5433/cafeos"
DIRECT_URL="postgresql://cafeos:cafeos@localhost:5433/cafeos"

# --- Runtime Mode --------------------------------------------
CHAYAONE_RUNTIME_MODE="local"       # local | hybrid | cloud
CHAYAONE_CLOUD_ENABLED="false"      # true | false
DEV_TENANT_SUBDOMAIN="kahwa"        # active local cafe subdomain

# --- Authentication Keys -------------------------------------
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
PLATFORM_JWT_SECRET="change-me-to-another-long-random-string"
OTP_DEV_ECHO="0"

# --- Optional Cloud Services (Supabase / Gemini / Razorpay) -
# SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service_role-key"
# SUPABASE_ANON_KEY="anon-public-key"
# SUPABASE_JWT_SECRET="supabase-project-jwt-secret"
# SUPABASE_BUCKET="uploads"
# GEMINI_API_KEY="AIzaSy-xxxx"
# RAZORPAY_KEY_ID="rzp_test_xxxx"
# RAZORPAY_KEY_SECRET="xxxx"
