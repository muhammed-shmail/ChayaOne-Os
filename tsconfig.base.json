{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@cafeos/types": ["./packages/types/src/index.ts"],
      "@cafeos/validation": ["./packages/validation/src/index.ts"],
      "@cafeos/realtime": ["./adapters/realtime/src/index.ts"],
      "@cafeos/core": ["./packages/core/src/index.ts"],
      "@cafeos/ui": ["./packages/ui/src/index.ts"],
      "@cafeos/ui/*": ["./packages/ui/src/*"],
      "@cafeos/db": ["./adapters/db-postgres/src/index.ts"],
      "@/*": ["./apps/pos-ui/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
